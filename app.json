{
  "expo": {
    "name": "ZeniaBiz",
    "slug": "zeniaBiz",
    "version": "2.8.17",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "zeniabiz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zeniabiz.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ZeniaBiz to access your camera to scan barcodes."
        }
      ],
      "./plugins/withGwpAsan"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "758ebee6-7784-4acb-aac9-5b5a861204c8"
      }
    },
    "owner": "zeniabiz-app"
  }
}